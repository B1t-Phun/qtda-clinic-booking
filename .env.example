
# Cấu hình chung cho frontend, backend và script Supabase.
PROJECT_NAME="ClinicCare"
APP_URL="http://cliniccare.localhost:3000"
AUTH_ADDITIONAL_ORIGINS=""
PORT="5000"

# Supabase: dùng cùng project trên các máy trong nhóm.
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# hCaptcha: site key công khai phải khớp secret đã cấu hình trong Supabase.
# Để site key trống chỉ khi project Supabase đã tắt CAPTCHA.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
NEXT_PUBLIC_AUTH_MANUAL_LINKING="false"

# Chỉ backend Express dùng service role. Không thêm NEXT_PUBLIC_ vào secret.
SUPABASE_SERVICE_ROLE_KEY=""

# Chỉ script quản trị Supabase dùng các biến dưới đây.
# Dùng lại project đã cấu hình thì không cần token/secret quản trị trên mọi máy.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_AUTH_CAPTCHA_SECRET=""

# OAuth tùy chọn: để trống cả cặp để giữ cấu hình hiện tại trên Supabase.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_GOOGLE_SECRET=""
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=""
SUPABASE_AUTH_FACEBOOK_SECRET=""

# Tùy chọn: true/false; để trống giữ cấu hình hiện tại (phụ thuộc gói Supabase).
SUPABASE_ENABLE_LEAKED_PASSWORD_PROTECTION=""
