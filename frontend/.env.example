NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
APP_URL=http://localhost:3000
# Enable hCaptcha in Supabase Attack Protection, then set your matching public site key.
# Leave blank until you have configured a real hCaptcha site and secret.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Optional. Enable manual identity linking in Supabase before exposing its controls.
NEXT_PUBLIC_AUTH_MANUAL_LINKING=false
# Service role key belongs only in backend/.env; auth routes use the publishable key and user sessions.
