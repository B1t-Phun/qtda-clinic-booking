# Copy to supabase/.env.local (ignored by Git). Keep secrets on the server.
# Required only when applying configuration through the Management API.
SUPABASE_ACCESS_TOKEN=
# APP_URL and the public hCaptcha site key are read from frontend/.env.local.
# Optional: comma-separated additional origins whose auth redirects should be allowed.
AUTH_ADDITIONAL_ORIGINS=

# Leave both fields blank to preserve the existing Google/Facebook configuration.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=

# Auth email uses the built-in Supabase delivery service.

# Put the matching NEXT_PUBLIC_HCAPTCHA_SITE_KEY in frontend/.env.local.
SUPABASE_AUTH_CAPTCHA_SECRET=
# Opt in only when the Supabase project plan supports leaked password protection.
SUPABASE_ENABLE_LEAKED_PASSWORD_PROTECTION=
